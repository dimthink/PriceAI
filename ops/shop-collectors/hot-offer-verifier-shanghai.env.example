# Single-node recovery profile for the current Shanghai hot verifier.
PRICEAI_HOT_VERIFY_MODE=write
PRICEAI_HOT_VERIFY_NODE_COUNT=1
PRICEAI_HOT_VERIFY_NODE_INDEX=0
PRICEAI_COLLECTOR_NODE_ID=shanghai-hot-1
PRICEAI_COLLECTOR_NODE_NAME=Shanghai hot verifier
PRICEAI_COLLECTOR_NODE_REGION=cn-shanghai

PRICEAI_HOT_VERIFY_TAKEOVER_AFTER_MS=0
PRICEAI_HOT_VERIFY_MAX_DURATION_MS=480000
PRICEAI_HOT_VERIFY_RECENT_REUSE_MS=90000
PRICEAI_HOT_VERIFY_REQUEST_DELAY_MS=1500
PRICEAI_HOT_VERIFY_STICKY_CANDIDATE_MS=1800000
PRICEAI_HOT_VERIFY_STALE_ALERT_MS=1200000
PRICEAI_HOT_VERIFY_PROXY_REUSE_TTL_MS=600000
PRICEAI_HOT_VERIFY_PROXY_MAX_RUNS=1

# Proxy credentials remain in /etc/priceai/collector-proxy.env.
PRICEAI_SHOPAPI_PROXY_HOSTS=www.ldxp.cn,pay.ldxp.cn,ldxp.cn,pay.qxvx.cn,catfk.com
